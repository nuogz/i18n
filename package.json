{
	"name": "@nuogz/i18n",
	"version": "3.7.1",
	"description": "Base internationalization library based on i18next for Nuogz libraries",
	"author": "DanoR",
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nuogz/i18n.git"
	},
	"private": false,
	"type": "module",
	"typesSource": [
		"node",
		"browser"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"main": "./index.js",
	"files": [
		"index.js",
		"types/**",
		"src/**",
		"**/*.d.ts"
	],
	"browser": {
		"./src/load-i18n-resource.lib.js": "./src/load-i18n-resource.js"
	},
	"typings": "./types/index.d.ts",
	"scripts": {
		"declare": "tsc",
		"postdeclare": "copy /Y bases.d.ts types"
	},
	"dependencies": {
		"i18next": "^23.12.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.7.0",
		"@stylistic/eslint-plugin-js": "^2.3.0",
		"@types/node": "^20.14.11",
		"eslint": "^9.7.0",
		"globals": "^15.8.0",
		"typescript": "^5.5.4"
	}
}
